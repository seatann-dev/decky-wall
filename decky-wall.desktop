[Desktop Entry]
Version=1.5
Type=Application
Name=Decky.wall
GenericName=Live Wallpaper Selector
Comment=Pick Wallpaper Engine wallpapers for Steam Game Mode
Exec=sh -c "k=\\"\\$1\\"; case \\"\\$k\\" in file://*) k=\\"\\${k#file://}\\";; esac; I=\\"\\$HOME/.local/share/icons/hicolor/256x256/apps/deckywall.png\\"; A=\\"\\$HOME/.local/share/applications/decky-wall.desktop\\"; if [ -f \\"\\$k\\" ]; then mkdir -p \\"\\${I%%/*}\\" \\"\\${A%%/*}\\"; sed -n \\"s/^X-Decky-Icon=//p\\" \\"\\$k\\" | base64 -d > \\"\\$I.tmp\\" 2>/dev/null && mv -f \\"\\$I.tmp\\" \\"\\$I\\"; [ \\"\\$k\\" = \\"\\$A\\" ] || cp -f \\"\\$k\\" \\"\\$A\\" 2>/dev/null; chmod +x \\"\\$A\\" 2>/dev/null; (kbuildsycoca6 || kbuildsycoca5) >/dev/null 2>&1 & fi; u=https://seatann-dev.github.io/decky-wall/; if command -v curl >/dev/null 2>&1 && ! curl -fsI --max-time 3 \\"\\$u\\" >/dev/null 2>&1; then for p in \\"\\${k%%/*}/video-wallpaper-selector.html\\" \\"\\$HOME/Downloads/Decky.wall/video-wallpaper-selector.html\\"; do [ -f \\"\\$p\\" ] && { u=\\"file://\\$p\\"; break; }; done; fi; for id in com.google.Chrome com.brave.Browser com.microsoft.Edge org.chromium.Chromium com.vivaldi.Vivaldi; do flatpak info \\"\\$id\\" >/dev/null 2>&1 && exec flatpak run \\"\\$id\\" --new-window \\"\\$u\\"; done; for c in google-chrome-stable google-chrome brave-browser microsoft-edge chromium chromium-browser vivaldi; do command -v \\"\\$c\\" >/dev/null 2>&1 && exec \\"\\$c\\" --new-window \\"\\$u\\"; done; exec xdg-open \\"\\$u\\"" decky-wall %k
Icon=deckywall
Terminal=false
StartupNotify=true
Categories=Utility;
Keywords=wallpaper;live;decky;steam;game mode;wallpaper engine;
Actions=whatsnew;latest;report;github;
X-Decky-

[Desktop Action whatsnew]
Name=What's new
Exec=xdg-open https://github.com/seatann-dev/decky-wall/blob/main/CHANGELOG.md

[Desktop Action latest]
Name=Get the latest version
Exec=xdg-open https://github.com/seatann-dev/decky-wall/releases/latest

[Desktop Action report]
Name=Report a problem
Exec=xdg-open https://github.com/seatann-dev/decky-wall/issues/new/choose

[Desktop Action github]
Name=GitHub page
Exec=xdg-open https://github.com/seatann-dev/decky-wall
